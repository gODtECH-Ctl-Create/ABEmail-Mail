NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=info@waste2light.com
NEXT_PUBLIC_APP_URL=https://mail.waste2light.com

# Web Push / VAPID. Generate once with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:info@waste2light.com
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
